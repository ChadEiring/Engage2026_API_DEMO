# Copy this file to ".env" and fill in your own values. Never commit or share ".env".

# A System Admin's API token: Profile > Personal Settings > API Access.
SMARTSHEET_ACCESS_TOKEN=
# The two sheets the audit writes to (Sheet > File > Properties).
FINDINGS_SHEET_ID=
RUNS_SHEET_ID=

# Optional. Everyone in your Smartsheet organisation counts as internal automatically; add extra email domains here (comma-separated).
INTERNAL_DOMAINS=
# Optional. Trusted partner domains that should NOT be flagged as external.
ALLOWED_EXTERNAL_DOMAINS=

# Optional: a third sheet (Owner, High, Medium, Low, Total) that the dashboard charts read.
EXPOSURE_SHEET_ID=
