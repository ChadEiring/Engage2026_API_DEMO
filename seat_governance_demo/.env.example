# Copy this file to ".env" and fill in your own values. Never commit or share ".env".

# Token must belong to a System Admin: Profile > Personal Settings > API Access.
SMARTSHEET_ACCESS_TOKEN=
# Plan ID: Admin Center, under the profile icon (or GET /users/{your id}/plans).
PLAN_ID=

# The three sheets this demo reads/writes (Sheet > File > Properties).
APPROVALS_SHEET_ID=
LOG_SHEET_ID=
LEAVERS_SHEET_ID=

# SAFETY RAIL: only these emails can ever be downgraded, deactivated or removed.
# Comma-separated, and use dedicated test accounts, never real colleagues.
ALLOWLIST_EMAILS=
# User ID of the account that receives a leaver's sheets when they are removed.
SERVICE_ACCOUNT_USER_ID=
# The test user whose seat you downgrade on camera (reset_demo2.py gives them a seat back).
DEMO_SEAT_USER_EMAIL=

# Optional tuning.
INACTIVE_DAYS=45
MAX_ACTIONS=5
# Optional: webhook shared secret, to verify callback signatures.
WEBHOOK_SHARED_SECRET=

# Optional. Value of the "Owner" tag on the AWS resources (default: demo-presenter).
OWNER_TAG=
